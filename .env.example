# ========================================
# サーバー側の環境変数（Vercel ダッシュボードで登録）
# ========================================
ANTHROPIC_API_KEY=sk-ant-xxxxx
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxx...
SUPABASE_ANON_KEY=sb_publishable_xx

# フロントエンドと同一ドメインで動かす場合は設定不要
# 外部クライアント（モバイルアプリ等）から呼ぶ場合に設定する
# CLIENT_URL=https://your-app.vercel.app

# ========================================
# クライアント側の環境変数（Vercel ダッシュボードで登録）
# REACT_APP_ プレフィックスが必須
# ========================================
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xx
